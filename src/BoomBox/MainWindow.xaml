<Window x:Class="BoomBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoomBox" Width="980" Height="640" MinWidth="820" MinHeight="520"
        Background="{StaticResource Page}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#191B21" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="BoomBox" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Turn a folder into a separate Linux system." Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,4,0,24"/>

                    <TextBlock Text="Folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource PathBox}" TextChanged="OnPathChanged"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Style="{StaticResource QuietButton}" Click="OnBrowseFolder"/>
                    </Grid>

                    <TextBlock Text="Linux Live ISO" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IsoBox" Style="{StaticResource PathBox}" TextChanged="OnPathChanged"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Style="{StaticResource QuietButton}" Click="OnBrowseIso"/>
                    </Grid>

                    <Button x:Name="CreateButton" Content="Create box" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnCreate"/>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock x:Name="StageText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" BorderThickness="0"
                                     Background="{StaticResource SurfaceHover}" Foreground="{StaticResource Accent}"/>
                        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Style="{StaticResource QuietButton}" Click="OnCancel"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <CheckBox x:Name="MenuCheck" Foreground="{StaticResource Muted}" Margin="0,16,0,0">
                        <TextBlock Text="Add &quot;Open in BoomBox&quot; to the right-click menu" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="28,24">
            <TextBlock DockPanel.Dock="Top" Text="Your boxes" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,14"/>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                    Padding="0,12,0,0" Margin="0,12,0,0">
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Boxes keep everyday apps away from Windows. They are not safe for real malware: use a full virtual machine for that."/>
            </Border>

            <Grid>
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="No boxes yet. Pick a folder and a Linux Live ISO to make your first one."
                           Visibility="Collapsed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BoxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding OsName}" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" Margin="0,8,0,12"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Delete" Foreground="{StaticResource Danger}"
                                                    Style="{StaticResource QuietButton}" Click="OnDelete"/>
                                            <WrapPanel>
                                                <Button Content="Open terminal" Style="{StaticResource PrimaryButton}"
                                                        Padding="12,6" Margin="0,0,8,0" Click="OnTerminal"/>
                                                <Button Content="Open folder" Style="{StaticResource QuietButton}"
                                                        Margin="0,0,8,0" Click="OnFolder"/>
                                                <Button Content="System files" Style="{StaticResource QuietButton}"
                                                        Margin="0,0,8,0" Click="OnSystemFiles"/>
                                                <Button Content="Stop" Style="{StaticResource QuietButton}"
                                                        IsEnabled="{Binding IsRunning}" Click="OnStop"/>
                                            </WrapPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
